// External GPU page: Live (history graph + gauge widgets), Tuning (power / clock limits through
// the service), Stress test, Options, Details. Data comes from src/egpu_page.rs via EgpuData.
import { Button, CheckBox, ComboBox, LineEdit, Slider, Switch, TextEdit, ScrollView, Palette } from "std-widgets.slint";

// lo / hi: the scale at the arc's two ends.
export struct Gauge { label: string, text: string, sub: string, frac: float, tone: int, warn: bool, lo: string, hi: string }
export struct Bar { label: string, text: string, frac: float, warn: bool }
export struct ResultRow { label: string, text: string }
export struct AmdFeat { name: string, on: bool }

export global EgpuData {
    // header
    in property <string> name;
    in property <string> sub;
    in property <bool> attached;
    in property <bool> nvidia;
    in property <bool> amd;
    // live
    in property <[Gauge]> gauges;
    in property <[Bar]> bars;
    in property <string> power-path;
    in property <string> temp-path;
    in property <string> clock-path;
    in property <string> limit-path;
    in property <string> y-top;
    in property <string> range-note;
    in-out property <int> range: 1;            // 0 1 min, 1 5 min, 2 15 min, 3 1 h
    in-out property <bool> show-power: true;
    in-out property <bool> show-temp: true;
    in-out property <bool> show-clock: true;
    // widgets (Widgets menu)
    in-out property <bool> w-history: true;
    in-out property <bool> w-gauges: true;
    in-out property <bool> w-bars: true;
    in-out property <bool> w-tuning: true;
    in-out property <bool> w-stress: true;
    // Section order: Tuning above Live.
    in-out property <bool> tuning-first;
    // tuning
    in property <bool> can-tune;
    in property <string> tune-note;
    in-out property <float> power-limit;
    in property <float> power-min: 100;
    in property <float> power-max: 250;
    in property <float> power-default: 250;
    in-out property <float> clock-cap;
    in property <float> clock-max: 2100;
    in property <string> mem-note;
    // Memory clock ceiling (NVIDIA RTX 30 and newer).
    in property <bool> can-mem;
    in property <float> mem-max: 10000;
    in-out property <float> mem-cap: 10000;
    // AMD (keel egpu amd-tune / amd-feature; the driver decides what is offered)
    in property <string> amd-note;
    in property <bool> amd-power-ok;
    in-out property <float> amd-power;
    in property <float> amd-power-min: -10;
    in property <float> amd-power-max: 10;
    in property <bool> amd-mhz-ok;
    in-out property <float> amd-mhz;
    in property <float> amd-mhz-min: 500;
    in property <float> amd-mhz-max: 3000;
    in property <[AmdFeat]> amd-features;
    in property <string> amd-refused;   // features the driver refused, hidden from the list
    in property <bool> amd-busy;
    // NVIDIA 3D settings (driver's global profile; written by the service)
    in property <bool> nv3d-ok;
    in property <string> nv3d-note;
    in-out property <float> nv-fps;
    in-out property <bool> nv-lowlat;
    in-out property <int> nv-vsync;      // 0 app, 1 off, 2 on
    in-out property <int> nv-pstate;     // 0 max performance, 1 adaptive, 2 optimal power
    in property <bool> nv3d-busy;
    // stress test
    in-out property <int> stress-length: 1;    // 0 1 min, 1 3 min, 2 10 min
    in property <bool> stress-running;
    // The card reports no power maximum and none was measured yet: the stress test finds it.
    in property <bool> power-unknown;
    in property <float> stress-progress;
    in property <string> stress-status;
    in property <[ResultRow]> stress-results;
    // options + details (existing)
    in-out property <bool> opt-legion;
    in property <bool> legion-ok: true;
    in-out property <bool> opt-primary;
    in-out property <bool> opt-prune;
    in-out property <bool> opt-search;
    in-out property <bool> opt-notify;
    in property <string> output;

    callback apply-limits();
    callback amd-load();
    callback nv3d-load();
    callback nv-fps-set();
    callback nv-lowlat-set();
    callback nv-vsync-set();
    callback nv-pstate-set();
    callback amd-apply();
    callback amd-reset();
    callback amd-feature(string, bool);
    callback default-limits();
    callback start-stress();
    callback stop-stress();
    callback options-changed();
    callback run(string);
    callback widgets-changed();
}

// A number typed in directly, kept in step with its slider and clamped to the range. Enter or
// leaving the box sets it. (No clear button: Fluent's LineEdit put one over the digits.)
component NumEdit inherits HorizontalLayout {
    in-out property <float> value;
    in property <float> minimum;
    in property <float> maximum;
    in property <string> unit;
    in property <bool> signed;
    callback committed();
    function shown() -> string { (root.signed && root.value > 0 ? "+" : "") + round(root.value) }
    function commit() {
        if (ti.text.is-float()) {
            let v = max(root.minimum, min(root.maximum, round(ti.text.to-float())));
            if (v != root.value) { root.value = v; root.committed(); }
        }
        ti.text = root.shown();
    }
    spacing: 6px;
    alignment: end;
    Rectangle {
        width: 84px;
        height: 32px;
        border-radius: 4px;
        border-width: 1px;
        border-color: ti.has-focus ? Palette.accent-background : Palette.border;
        background: Palette.control-background;
        ti := TextInput {
            x: 8px;
            width: parent.width - 16px;
            height: parent.height;
            horizontal-alignment: right;
            vertical-alignment: center;
            font-size: 16px;
            color: Palette.foreground;
            single-line: true;
            text: root.shown();
            accepted => { root.commit(); self.clear-focus(); }
            changed has-focus => { if (!self.has-focus) { root.commit(); } }
        }
    }
    changed value => { if (!ti.has-focus) { ti.text = root.shown(); } }
    Text { text: root.unit; vertical-alignment: center; font-weight: 600; width: 34px; }
}

component Card inherits Rectangle {
    border-radius: 8px;
    border-width: 1px;
    border-color: Palette.border;
    background: Palette.control-background;
    @children
}

component Section inherits Text {
    font-size: 12px;
    font-weight: 600;
    color: Palette.foreground.with-alpha(0.65);
}

// Colours of the series; light / dark pairs keep contrast on both backgrounds.
global Tones {
    out property <color> power: Palette.color-scheme == ColorScheme.dark ? #f2894f : #c2410c;
    out property <color> temp: Palette.color-scheme == ColorScheme.dark ? #b99af7 : #7c3aed;
    out property <color> clock: Palette.color-scheme == ColorScheme.dark ? #4ca6e8 : #0f6cbd;
    out property <color> usage: Palette.color-scheme == ColorScheme.dark ? #3ec3cb : #0e7c86;
    // Near a limit: power at its limit, temperature near throttling, VRAM almost full.
    out property <color> warn: Palette.color-scheme == ColorScheme.dark ? #ff6b6b : #c42b1c;
    public pure function of(i: int) -> color {
        i == 0 ? power : (i == 1 ? temp : (i == 2 ? clock : usage))
    }
}

// Half-ring meter (270 degrees), value arc over a track.
component Meter inherits Rectangle {
    in property <Gauge> g;
    property <float> f: max(0.0, min(1.0, g.frac));
    property <angle> a0: 135deg;
    property <angle> a1: 135deg + 270deg * f;
    VerticalLayout {
        padding: 10px;
        spacing: 2px;
        Text { text: g.label; font-size: 12px; color: Palette.foreground.with-alpha(0.7); }
        Rectangle {
            height: 96px;
            Path {
                x: (parent.width - self.width) / 2;
                width: 96px; height: 96px;
                viewbox-width: 100; viewbox-height: 100;
                stroke: Palette.foreground.with-alpha(0.12); stroke-width: 9px; fill: transparent;
                commands: "M " + (50 + 40 * cos(135deg)) + " " + (50 + 40 * sin(135deg)) + " A 40 40 0 1 1 " + (50 + 40 * cos(45deg)) + " " + (50 + 40 * sin(45deg));
            }
            if f > 0.03 : Path {
                x: (parent.width - self.width) / 2;
                width: 96px; height: 96px;
                viewbox-width: 100; viewbox-height: 100;
                stroke: g.warn ? Tones.warn : Tones.of(g.tone); stroke-width: 9px; fill: transparent;
                commands: "M " + (50 + 40 * cos(a0)) + " " + (50 + 40 * sin(a0)) + " A 40 40 0 " + (f > 0.667 ? 1 : 0) + " 1 " + (50 + 40 * cos(a1)) + " " + (50 + 40 * sin(a1));
            }
            Text { y: 34px; text: g.text; font-size: 20px; font-weight: 600; horizontal-alignment: center; width: parent.width; color: g.warn ? Tones.warn : Palette.foreground; }
            Text { y: 62px; text: g.sub; font-size: 10px; color: Palette.foreground.with-alpha(0.65); horizontal-alignment: center; width: parent.width; }
            Text { x: (parent.width - 96px) / 2 + 1px; y: 84px; width: 40px; text: g.lo; font-size: 10px; color: Palette.foreground.with-alpha(0.5); horizontal-alignment: center; }
            Text { x: (parent.width - 96px) / 2 + 55px; y: 84px; width: 40px; text: g.hi; font-size: 10px; color: Palette.foreground.with-alpha(0.5); horizontal-alignment: center; }
        }
    }
}

component Legend inherits Rectangle {
    in property <string> text;
    in property <color> tone;
    in-out property <bool> on;
    height: 26px;
    width: lbl.preferred-width + 30px;
    border-radius: 13px;
    border-width: 1px;
    border-color: on ? tone : Palette.border;
    background: ta.has-hover ? Palette.alternate-background : transparent;
    Rectangle { x: 10px; width: 10px; height: 3px; background: on ? tone : Palette.foreground.with-alpha(0.3); }
    lbl := Text { x: 24px; text: root.text; font-size: 12px; vertical-alignment: center; color: on ? Palette.foreground : Palette.foreground.with-alpha(0.5); }
    ta := TouchArea { clicked => { root.on = !root.on; } }
}

component Seg inherits HorizontalLayout {
    in property <[string]> items;
    in-out property <int> current;
    callback picked(int);
    spacing: 0;
    for t[i] in items : Rectangle {
        height: 28px;
        width: tx.preferred-width + 20px;
        border-width: 1px;
        border-color: Palette.border;
        background: root.current == i ? Palette.alternate-background : (sa.has-hover ? Palette.alternate-background.with-alpha(0.5) : transparent);
        tx := Text { text: t; font-size: 12px; font-weight: root.current == i ? 600 : 400; vertical-alignment: center; horizontal-alignment: center; }
        sa := TouchArea { clicked => { root.current = i; root.picked(i); } }
    }
}

export component EgpuPage inherits ScrollView {
    VerticalLayout {
        // As wide as the visible area: the page shrinks with the window instead of being cut off.
        width: root.visible-width;
        spacing: 14px;
        padding-right: 12px;
        // Wrapped texts can come out taller than measured: room so the last row is not cut off.
        padding-bottom: 32px;
        alignment: start;

        HorizontalLayout {
            spacing: 12px;
            Text { text: "External GPU"; font-size: 24px; font-weight: 600; vertical-alignment: center; }
            Rectangle {
                width: chip.preferred-width + 30px; height: 26px; border-radius: 13px;
                border-width: 1px; border-color: Palette.border;
                Rectangle { x: 10px; width: 8px; height: 8px; border-radius: 4px; background: EgpuData.attached ? #2ea043 : Palette.foreground.with-alpha(0.35); }
                chip := Text { x: 24px; text: EgpuData.name; font-size: 12px; vertical-alignment: center; }
            }
            Text { text: EgpuData.sub; color: Palette.foreground.with-alpha(0.65); vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
            widgets-btn := Button { text: "Widgets"; clicked => { picker.show(); } }
        }

        picker := PopupWindow {
            x: parent.width - 260px; y: 40px; width: 240px;
            close-policy: close-on-click-outside;
            Rectangle {
                background: Palette.background; border-radius: 8px; border-width: 1px; border-color: Palette.border;
                VerticalLayout {
                    padding: 12px; spacing: 6px;
                    Text { text: "Show on this page"; font-weight: 600; }
                    CheckBox { text: "History graph"; checked <=> EgpuData.w-history; toggled => { EgpuData.widgets-changed(); } }
                    CheckBox { text: "Gauges"; checked <=> EgpuData.w-gauges; toggled => { EgpuData.widgets-changed(); } }
                    CheckBox { text: "Clocks and memory"; checked <=> EgpuData.w-bars; toggled => { EgpuData.widgets-changed(); } }
                    CheckBox { text: "Tuning"; checked <=> EgpuData.w-tuning; toggled => { EgpuData.widgets-changed(); } }
                    CheckBox { text: "Stress test"; checked <=> EgpuData.w-stress; toggled => { EgpuData.widgets-changed(); } }
                    CheckBox { text: "Tuning above Live"; checked <=> EgpuData.tuning-first; toggled => { EgpuData.widgets-changed(); } }
                }
            }
        }

        if !EgpuData.attached : Card {
            height: 64px;
            Text { x: 16px; text: "No eGPU attached."; color: Palette.foreground.with-alpha(0.7); vertical-alignment: center; }
        }

        // Live and Tuning in the order the user picked (Widgets > Tuning above Live).
        for sid in EgpuData.tuning-first ? ["tuning", "live"] : ["live", "tuning"] : VerticalLayout {
            spacing: 14px;
            // ---- Live
            if sid == "live" && EgpuData.attached && (EgpuData.w-history || EgpuData.w-gauges || EgpuData.w-bars) : VerticalLayout {
                spacing: 8px;
                Section { text: "LIVE"; }
                HorizontalLayout {
                    spacing: 12px;
                    if EgpuData.w-history : Card {
                        horizontal-stretch: 1;
                        min-width: 340px;
                        height: 300px;
                        VerticalLayout {
                            padding: 12px; spacing: 8px;
                            HorizontalLayout { spacing: 6px;
                                Text { text: "History"; font-weight: 600; vertical-alignment: center; }
                                Legend { text: "Power"; tone: Tones.power; on <=> EgpuData.show-power; }
                                Legend { text: "Temp"; tone: Tones.temp; on <=> EgpuData.show-temp; }
                                Legend { text: "Clock"; tone: Tones.clock; on <=> EgpuData.show-clock; }
                            }
                            Rectangle {
                                vertical-stretch: 1;
                                for i in 5 : Rectangle { y: parent.height * i / 4 - 0.5px; height: 1px; background: Palette.foreground.with-alpha(0.08); }
                                Path { width: 100%; height: 100%; viewbox-width: 600; viewbox-height: 200; fit: fill; stroke: Tones.power.with-alpha(0.55); stroke-width: 1px; fill: transparent; commands: EgpuData.limit-path; visible: EgpuData.show-power && EgpuData.limit-path != ""; }
                                Path { width: 100%; height: 100%; viewbox-width: 600; viewbox-height: 200; fit: fill; stroke: Tones.clock; stroke-width: 1.6px; fill: transparent; commands: EgpuData.clock-path; visible: EgpuData.show-clock && EgpuData.clock-path != ""; }
                                Path { width: 100%; height: 100%; viewbox-width: 600; viewbox-height: 200; fit: fill; stroke: Tones.temp; stroke-width: 1.6px; fill: transparent; commands: EgpuData.temp-path; visible: EgpuData.show-temp && EgpuData.temp-path != ""; }
                                Path { width: 100%; height: 100%; viewbox-width: 600; viewbox-height: 200; fit: fill; stroke: Tones.power; stroke-width: 2px; fill: transparent; commands: EgpuData.power-path; visible: EgpuData.show-power && EgpuData.power-path != ""; }
                            }
                            HorizontalLayout { spacing: 8px;
                                Text { text: EgpuData.range-note; font-size: 11px; color: Palette.foreground.with-alpha(0.6); wrap: word-wrap; vertical-alignment: center; horizontal-stretch: 1; }
                                Seg { items: ["1 m", "5 m", "15 m", "1 h"]; current <=> EgpuData.range; }
                            }
                        }
                    }
                    if EgpuData.w-gauges || EgpuData.w-bars : VerticalLayout {
                        spacing: 12px;
                        width: 312px;
                        if EgpuData.w-gauges : HorizontalLayout {
                            spacing: 8px;
                            for g in EgpuData.gauges : Card { height: 140px; Meter { width: 100%; height: 100%; g: g; } }
                        }
                        if EgpuData.w-bars : Card {
                            VerticalLayout {
                                padding: 12px; spacing: 10px; alignment: start;
                                Text { text: "Clocks and memory (bars: against the highest seen)"; font-size: 12px; color: Palette.foreground.with-alpha(0.7); wrap: word-wrap; }
                                for b in EgpuData.bars : VerticalLayout {
                                    spacing: 3px;
                                    HorizontalLayout {
                                        Text { text: b.label; font-size: 12px; }
                                        Rectangle { horizontal-stretch: 1; }
                                        Text { text: b.text; font-size: 12px; color: b.warn ? Tones.warn : Palette.foreground; }
                                    }
                                    Rectangle {
                                        height: 6px; border-radius: 3px; background: Palette.foreground.with-alpha(0.1);
                                        Rectangle { x: 0; width: parent.width * max(0.0, min(1.0, b.frac)); height: 6px; border-radius: 3px; background: b.warn ? Tones.warn : Tones.clock; }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ---- Tuning: limits and the stress test side by side in one full-width card
            if sid == "tuning" && EgpuData.attached && (EgpuData.w-tuning || EgpuData.w-stress) : VerticalLayout {
                spacing: 8px;
                Section { text: "TUNING"; }
                Card {
                    TouchArea { clicked => { focus-sink.focus(); } }
                    focus-sink := FocusScope { width: 0px; height: 0px; }
                    HorizontalLayout {
                        padding: 14px; spacing: 20px;
                        if EgpuData.w-tuning : VerticalLayout {
                            horizontal-stretch: 1; spacing: 10px; alignment: start;
                            if !EgpuData.can-tune && EgpuData.tune-note != "" : Text { text: EgpuData.tune-note; wrap: word-wrap; color: Palette.foreground.with-alpha(0.7); }
                            // AMD: what the driver offers for this card, then the Radeon features.
                            if EgpuData.amd && EgpuData.amd-note != "" : Text { text: EgpuData.amd-note; wrap: word-wrap; font-size: 12px; color: Palette.foreground.with-alpha(0.7); }
                            if EgpuData.amd && EgpuData.amd-power-ok : VerticalLayout {
                                spacing: 4px;
                                HorizontalLayout {
                                    Text { text: "Power limit"; font-weight: 600; }
                                    Rectangle { horizontal-stretch: 1; }
                                    NumEdit { value <=> EgpuData.amd-power; minimum: EgpuData.amd-power-min; maximum: EgpuData.amd-power-max; unit: "%"; signed: true; }
                                }
                                Slider { minimum: EgpuData.amd-power-min; maximum: EgpuData.amd-power-max; value <=> EgpuData.amd-power; }
                            }
                            if EgpuData.amd && EgpuData.amd-mhz-ok : VerticalLayout {
                                spacing: 4px;
                                HorizontalLayout {
                                    Text { text: "Max clock"; font-weight: 600; }
                                    Rectangle { horizontal-stretch: 1; }
                                    NumEdit { value <=> EgpuData.amd-mhz; minimum: EgpuData.amd-mhz-min; maximum: EgpuData.amd-mhz-max; unit: "MHz"; }
                                }
                                Slider { minimum: EgpuData.amd-mhz-min; maximum: EgpuData.amd-mhz-max; value <=> EgpuData.amd-mhz; }
                            }
                            if EgpuData.amd && (EgpuData.amd-power-ok || EgpuData.amd-mhz-ok) : HorizontalLayout {
                                spacing: 8px; alignment: start;
                                Button { text: "Apply"; primary: true; enabled: !EgpuData.amd-busy; clicked => { EgpuData.amd-apply(); } }
                                Button { text: "Factory"; enabled: !EgpuData.amd-busy; clicked => { EgpuData.amd-reset(); } }
                            }
                            if EgpuData.amd && EgpuData.amd-features.length > 0 : VerticalLayout {
                                spacing: 6px;
                                Text { text: "Radeon features"; font-weight: 600; }
                                for f in EgpuData.amd-features : HorizontalLayout {
                                    Text { text: f.name; vertical-alignment: center; horizontal-stretch: 1; }
                                    Switch { checked: f.on; enabled: !EgpuData.amd-busy; toggled => { EgpuData.amd-feature(f.name, self.checked); } }
                                }
                                Text { text: "Applied to this eGPU only; set again on every attach. Chill and Anti-Lag cannot both be on (the driver turns the other off)."; font-size: 11px; color: Palette.foreground.with-alpha(0.6); wrap: word-wrap; }
                                if EgpuData.amd-refused != "" : Text { text: "Not offered by this driver: " + EgpuData.amd-refused + "."; font-size: 11px; color: Palette.foreground.with-alpha(0.6); wrap: word-wrap; }
                            }
                            if EgpuData.can-tune : VerticalLayout {
                                spacing: 4px;
                                HorizontalLayout {
                                    Text { text: "Power limit"; font-weight: 600; }
                                    Rectangle { horizontal-stretch: 1; }
                                    NumEdit { value <=> EgpuData.power-limit; minimum: EgpuData.power-min; maximum: EgpuData.power-max; unit: "W"; }
                                }
                                Slider { minimum: EgpuData.power-min; maximum: EgpuData.power-max; value <=> EgpuData.power-limit; }
                                HorizontalLayout {
                                    Text { text: round(EgpuData.power-min) + " W"; font-size: 11px; color: Palette.foreground.with-alpha(0.6); }
                                    Rectangle { horizontal-stretch: 1; }
                                    Text { text: "default " + round(EgpuData.power-default) + " W · max " + round(EgpuData.power-max) + " W"; font-size: 11px; color: Palette.foreground.with-alpha(0.6); }
                                }
                            }
                            if EgpuData.can-tune : VerticalLayout {
                                spacing: 4px;
                                HorizontalLayout {
                                    Text { text: "Core clock ceiling"; font-weight: 600; }
                                    Rectangle { horizontal-stretch: 1; }
                                    if EgpuData.clock-cap >= EgpuData.clock-max - 1 : Text { text: "no ceiling"; vertical-alignment: center; color: Palette.foreground.with-alpha(0.6); }
                                    NumEdit { value <=> EgpuData.clock-cap; minimum: 600; maximum: EgpuData.clock-max; unit: "MHz"; }
                                }
                                Slider { minimum: 600; maximum: EgpuData.clock-max; value <=> EgpuData.clock-cap; }
                                HorizontalLayout {
                                    Text { text: "600 MHz"; font-size: 11px; color: Palette.foreground.with-alpha(0.6); }
                                    Rectangle { horizontal-stretch: 1; }
                                    Text { text: "max " + round(EgpuData.clock-max) + " MHz = no ceiling"; font-size: 11px; color: Palette.foreground.with-alpha(0.6); }
                                }
                            }
                            if EgpuData.can-tune && EgpuData.can-mem : VerticalLayout {
                                spacing: 4px;
                                HorizontalLayout {
                                    Text { text: "Memory clock ceiling"; font-weight: 600; }
                                    Rectangle { horizontal-stretch: 1; }
                                    if EgpuData.mem-cap >= EgpuData.mem-max - 1 : Text { text: "no ceiling"; vertical-alignment: center; color: Palette.foreground.with-alpha(0.6); }
                                    NumEdit { value <=> EgpuData.mem-cap; minimum: 400; maximum: EgpuData.mem-max; unit: "MHz"; }
                                }
                                Slider { minimum: 400; maximum: EgpuData.mem-max; value <=> EgpuData.mem-cap; }
                                HorizontalLayout {
                                    Text { text: "400 MHz"; font-size: 11px; color: Palette.foreground.with-alpha(0.6); }
                                    Rectangle { horizontal-stretch: 1; }
                                    Text { text: "max " + round(EgpuData.mem-max) + " MHz = no ceiling"; font-size: 11px; color: Palette.foreground.with-alpha(0.6); }
                                }
                            }
                            if EgpuData.mem-note != "" : Rectangle {
                                border-radius: 6px; background: Palette.alternate-background;
                                height: mem.preferred-height + 16px;
                                mem := Text { x: 10px; width: parent.width - 20px; text: EgpuData.mem-note; wrap: word-wrap; font-size: 12px; }
                            }
                            if EgpuData.can-tune : HorizontalLayout {
                                spacing: 8px; alignment: start;
                                Button { text: "Apply"; primary: true; clicked => { EgpuData.apply-limits(); } }
                                Button { text: "Driver defaults"; clicked => { EgpuData.default-limits(); } }
                            }
                            if EgpuData.can-tune : Text { text: "Saved in the service; applied on every attach."; font-size: 11px; color: Palette.foreground.with-alpha(0.6); wrap: word-wrap; }
                        }
                        if EgpuData.w-tuning && (EgpuData.w-stress || EgpuData.nvidia) : Rectangle { width: 1px; background: Palette.foreground.with-alpha(0.1); }
                        if EgpuData.w-stress || EgpuData.nvidia : VerticalLayout {
                            horizontal-stretch: 1; spacing: 10px; alignment: start;
                            if EgpuData.w-stress : VerticalLayout {
                                spacing: 10px;
                                Text { text: "Stress test"; font-weight: 600; }
                                if EgpuData.power-unknown && !EgpuData.stress-running : Text { text: "This card reports no power maximum: run a test once and the power gauge uses what it reaches."; font-size: 12px; color: Palette.foreground.with-alpha(0.7); wrap: word-wrap; }
                                HorizontalLayout {
                                    spacing: 10px;
                                    Text { text: "Length"; vertical-alignment: center; }
                                    Seg { items: ["1 m", "3 m", "10 m"]; current <=> EgpuData.stress-length; }
                                }
                                HorizontalLayout { spacing: 8px; alignment: start;
                                    if !EgpuData.stress-running : Button { text: "Start"; primary: true; clicked => { EgpuData.start-stress(); } }
                                    if EgpuData.stress-running : Button { text: "Stop"; clicked => { EgpuData.stop-stress(); } }
                                    // The summary of the last run, in a popup once it is ready.
                                    Button { text: "Report"; enabled: !EgpuData.stress-running && EgpuData.stress-results.length > 0; clicked => { report.show(); } }
                                }
                                if EgpuData.stress-running : Rectangle {
                                    height: 6px; border-radius: 3px; background: Palette.foreground.with-alpha(0.1);
                                    Rectangle { x: 0; width: parent.width * EgpuData.stress-progress; height: 6px; border-radius: 3px; background: Tones.power; }
                                }
                                Text { text: EgpuData.stress-status; font-size: 12px; color: Palette.foreground.with-alpha(0.7); wrap: word-wrap; }
                                report := PopupWindow {
                                    x: -40px; y: -20px; width: 460px;
                                    close-policy: close-on-click-outside;
                                    Rectangle {
                                        background: Palette.background; border-radius: 10px; border-width: 1px; border-color: Palette.border;
                                        drop-shadow-blur: 12px; drop-shadow-color: #00000040;
                                        VerticalLayout {
                                            padding: 16px; spacing: 8px;
                                            HorizontalLayout {
                                                Text { text: "Stress test report"; font-size: 15px; font-weight: 700; vertical-alignment: center; }
                                                Rectangle { horizontal-stretch: 1; }
                                                Button { text: "Close"; clicked => { report.close(); } }
                                            }
                                            for r in EgpuData.stress-results : HorizontalLayout {
                                                Text { text: r.label; width: 150px; font-size: 13px; color: Palette.foreground.with-alpha(0.65); }
                                                Text { text: r.text; font-size: 13px; wrap: word-wrap; horizontal-stretch: 1; }
                                            }
                                        }
                                    }
                                }
                            }
                            if EgpuData.nvidia && (EgpuData.nv3d-ok || EgpuData.nv3d-note != "") : VerticalLayout {
                                spacing: 8px;
                                Rectangle { height: 1px; background: Palette.foreground.with-alpha(0.1); }
                                Text { text: "3D settings (all games)"; font-weight: 600; }
                                if EgpuData.nv3d-note != "" : Text { text: EgpuData.nv3d-note; font-size: 12px; wrap: word-wrap; color: Palette.foreground.with-alpha(0.7); }
                                if EgpuData.nv3d-ok : HorizontalLayout { spacing: 8px;
                                    Text { text: "Max frame rate"; vertical-alignment: center; horizontal-stretch: 1; }
                                    NumEdit { value <=> EgpuData.nv-fps; minimum: 0; maximum: 1000; unit: "fps"; committed => { EgpuData.nv-fps-set(); } }
                                }
                                if EgpuData.nv3d-ok : HorizontalLayout { spacing: 8px;
                                    Text { text: "Low latency"; vertical-alignment: center; horizontal-stretch: 1; }
                                    Switch { checked <=> EgpuData.nv-lowlat; enabled: !EgpuData.nv3d-busy; toggled => { EgpuData.nv-lowlat-set(); } }
                                }
                                if EgpuData.nv3d-ok : HorizontalLayout { spacing: 8px;
                                    Text { text: "Vertical sync"; vertical-alignment: center; horizontal-stretch: 1; }
                                    ComboBox { width: 180px; model: ["Use the app's setting", "Off", "On"]; current-index <=> EgpuData.nv-vsync; enabled: !EgpuData.nv3d-busy; selected => { EgpuData.nv-vsync-set(); } }
                                }
                                if EgpuData.nv3d-ok : HorizontalLayout { spacing: 8px;
                                    Text { text: "Power management"; vertical-alignment: center; horizontal-stretch: 1; }
                                    ComboBox { width: 180px; model: ["Maximum performance", "Adaptive", "Optimal power"]; current-index <=> EgpuData.nv-pstate; enabled: !EgpuData.nv3d-busy; selected => { EgpuData.nv-pstate-set(); } }
                                }
                                if EgpuData.nv3d-ok : Text { text: "Max frame rate 0 = no limit. Applied at once, for every game on the NVIDIA eGPU."; font-size: 11px; color: Palette.foreground.with-alpha(0.6); wrap: word-wrap; }
                            }
                        }
                    }
                }
            }

        }

        // ---- Options
        VerticalLayout {
            spacing: 6px;
            Section { text: "OPTIONS (THE TRAY DOES THESE)"; }
            CheckBox {
                text: "Keep Legion Space on the iGPU and the built-in screen";
                // Off works any time (it also clears the iGPU preference); on needs the built-in screen as main.
                enabled: EgpuData.legion-ok || EgpuData.opt-legion;
                Tooltip {
                    text: EgpuData.legion-ok ? @markdown("Moves Legion Space's windows to the built-in screen.")
                        : @markdown("Needs the built-in screen as main display.");
                }
                checked <=> EgpuData.opt-legion; toggled => { EgpuData.options-changed(); }
            }
            CheckBox { text: "Make the eGPU monitor the main display on attach"; checked <=> EgpuData.opt-primary; toggled => { EgpuData.options-changed(); } }
            CheckBox { text: "Clean up duplicate AMD tray icons"; checked <=> EgpuData.opt-prune; toggled => { EgpuData.options-changed(); } }
            CheckBox { text: "Restart Windows Search after integer scaling changes"; checked <=> EgpuData.opt-search; toggled => { EgpuData.options-changed(); } }
            CheckBox { text: "Notifications"; checked <=> EgpuData.opt-notify; toggled => { EgpuData.options-changed(); } }
        }

        // ---- Details
        VerticalLayout {
            spacing: 6px;
            Section { text: "DETAILS"; }
            HorizontalLayout {
                spacing: 8px; alignment: start;
                Button { text: "Driver"; clicked => { EgpuData.run("egpu driver-status"); } }
                Button { text: "Displays"; clicked => { EgpuData.run("egpu display"); } }
                if EgpuData.amd : Button { text: "AMD features"; clicked => { EgpuData.run("egpu amd-features"); } }
                if EgpuData.nvidia : Button { text: "NVIDIA display scaling"; clicked => { EgpuData.run("egpu nv-scaling"); } }
                Button { text: "Service status"; clicked => { EgpuData.run("egpu status"); } }
            }
            if EgpuData.output != "" : TextEdit { text: EgpuData.output; read-only: true; font-size: 12px; min-height: 240px; }
        }
    }
}
