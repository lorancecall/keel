// Side menu: the boat logo, one item per page (icon + name), group headings, Settings at the
// bottom. Three modes (Settings > Side menu): 0 icon and text, 1 icons only (the name is a
// tooltip), 2 text only. Icons are stroke paths on a 24-unit grid (same as the design canvas).
import { Palette } from "std-widgets.slint";

// Page numbers used by main.slint and src/main.rs.
export global Pages {
    out property <int> home: 0;
    out property <int> apps: 1;
    out property <int> background: 2;
    out property <int> memory-history: 3;
    out property <int> external-gpu: 4;
    out property <int> local-ai: 5;
    out property <int> displays: 6;
    out property <int> network: 7;
    out property <int> settings: 8;
    out property <int> games: 9;
}

struct NavEntry { page: int, label: string, icon: string, group: string }

component NavIcon inherits Path {
    in property <color> tint;
    width: 18px;
    height: 18px;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: tint;
    stroke-width: 1.6px;
    fill: transparent;
}

component NavItem inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> selected;
    in property <int> mode;
    in property <bool> enabled: true;
    in property <string> why-off;
    callback clicked();
    height: 36px;
    opacity: enabled ? 1.0 : 0.4;
    border-radius: 6px;
    background: selected ? Palette.alternate-background : (ta.has-hover && enabled ? Palette.alternate-background.with-alpha(0.55) : transparent);
    Rectangle {
        x: 0; width: 3px; height: 16px; border-radius: 2px;
        background: selected ? Palette.accent-background : transparent;
    }
    NavIcon {
        visible: root.mode != 2;
        x: root.mode == 1 ? (parent.width - self.width) / 2 : 12px;
        commands: root.icon;
        tint: Palette.foreground;
    }
    Text {
        visible: root.mode != 1;
        x: root.mode == 2 ? 14px : 42px;
        text: root.text;
        vertical-alignment: center;
        font-weight: root.selected ? 600 : 400;
        overflow: elide;
        width: parent.width - self.x - 8px;
    }
    ta := TouchArea {
        clicked => { if (root.enabled) { root.clicked(); } }
        if root.mode == 1 || !root.enabled : Tooltip { text: root.enabled ? @markdown("\{root.text}") : @markdown("\{root.why-off}"); }
    }
}

export component SideMenu inherits VerticalLayout {
    in property <int> mode;
    in property <int> page;
    in property <bool> local-ai-on: true;
    callback picked(int);

    property <[NavEntry]> top: [
        { page: 0, label: "Home", group: "", icon: "M3 3h7v7H3z M14 3h7v7h-7z M3 14h7v7H3z M14 14h7v7h-7z" },
        { page: 1, label: "Apps", group: "Memory", icon: "M4 7h16v10H4z M8 7V4 M12 7V4 M16 7V4 M8 20v-3 M12 20v-3 M16 20v-3" },
        { page: 2, label: "On-demand apps", group: "", icon: "M12 3L3 8l9 5 9-5z M3 12.5l9 5 9-5 M3 17l9 5 9-5" },
        { page: 3, label: "Memory history", group: "", icon: "M3 17l5-5 4 3 8-8 M15 7h5v5" },
        { page: 4, label: "External GPU", group: "Graphics", icon: "M2 6h17v11H2z M11.6 11.5A2.6 2.6 0 1 1 6.4 11.5A2.6 2.6 0 1 1 11.6 11.5 M19 9h3 M19 14h3 M5 17v3" },
        { page: 5, label: "Local AI", group: "", icon: "M6 6h12v12H6z M9 2v4 M15 2v4 M9 18v4 M15 18v4 M2 9h4 M2 15h4 M18 9h4 M18 15h4 M10 10h4v4h-4z" },
        { page: 6, label: "Displays", group: "", icon: "M3 4h18v12H3z M8 20h8 M12 16v4" },
        { page: 9, label: "GPU apps", group: "", icon: "M7 8h10a5 5 0 0 1 5 5v1a3 3 0 0 1-5.4 1.8L15 14H9l-1.6 1.8A3 3 0 0 1 2 14v-1a5 5 0 0 1 5-5z M7 10.5v3 M5.5 12h3 M15.5 11h.01 M17.5 13h.01" },
        { page: 7, label: "Network", group: " ", icon: "M21 12A9 9 0 1 1 3 12A9 9 0 1 1 21 12 M3 12h18 M12 3c3 3.5 3 14.5 0 18 M12 3c-3 3.5-3 14.5 0 18" },
    ];

    width: mode == 1 ? 60px : (mode == 2 ? 180px : 220px);
    spacing: 2px;
    padding-top: 4px;

    // Logo: the boat alone, in the text colour (light and dark themes).
    Rectangle {
        height: 48px;
        Image {
            visible: root.mode != 2;
            source: @image-url("../../../assets/keel-boat.png");
            colorize: Palette.foreground;
            width: 28px;
            height: 28px;
            x: root.mode == 1 ? (parent.width - self.width) / 2 : 12px;
        }
        Text {
            visible: root.mode != 1;
            x: root.mode == 2 ? 14px : 50px;
            text: "Keel"; font-size: 20px; font-weight: 700; vertical-alignment: center;
        }
    }

    for e in root.top : VerticalLayout {
        spacing: 2px;
        // A group starts: heading (or a short line in icon mode); " " = a gap without a name.
        if e.group != "" && root.mode != 1 : Text {
            text: e.group == " " ? "" : e.group;
            height: 28px;
            vertical-alignment: bottom;
            font-size: 11px;
            font-weight: 600;
            color: Palette.foreground.with-alpha(0.6);
            x: 12px;
        }
        if e.group != "" && root.mode == 1 : Rectangle {
            height: 13px;
            Rectangle { width: 28px; height: 1px; background: Palette.border; }
        }
        NavItem {
            text: e.label; icon: e.icon; mode: root.mode;
            enabled: e.page != Pages.local-ai || root.local-ai-on;
            why-off: "Local AI needs an eGPU: without one, models only take system memory.";
            selected: root.page == e.page;
            clicked => { root.picked(e.page); }
        }
    }

    Rectangle { vertical-stretch: 1; }

    NavItem {
        text: "Settings"; mode: root.mode;
        icon: "M15 12A3 3 0 1 1 9 12A3 3 0 1 1 15 12 M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z";
        selected: root.page == 8;
        clicked => { root.picked(8); }
    }
}
